NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS to read/write the locked-down google_credentials
# table. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (same client configured as the Supabase Google provider).
# Used server-side to exchange a user's refresh token for YouTube API access tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe billing (optional; card payments are disabled until set) ---
# When STRIPE_SECRET_KEY and a resolvable app base URL (APP_BASE_URL below, or
# Vercel's deployment URL) are both present, the Billing settings tab lets users
# add/manage a card via Stripe-hosted Checkout (setup mode) + Customer Portal,
# and the Plans page lets them subscribe to a paid plan (subscription Checkout).
# Card data never touches this server. Use test keys (sk_test_…) in development.
#
# Server-only secret key (Stripe Dashboard → Developers → API keys). Never expose.
STRIPE_SECRET_KEY=
# Webhook signing secret used to verify events hitting /api/stripe/webhook.
# Local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the whsec_… it prints. Production: create a webhook endpoint in the
# Stripe Dashboard for that URL, subscribing to checkout.session.completed,
# customer.updated, payment_method.detached, and the customer.subscription.*
# events (created, updated, deleted), then copy its signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids for each paid plan × billing period (Stripe Dashboard →
# Product catalogue → your Starter/Pro products → Prices). Create a recurring
# monthly and a recurring yearly price per plan and paste their price_… ids
# here. A blank value means that plan/period can't be purchased yet. These map
# to lib/plans.ts (Starter £15/mo or £150/yr, Pro £25/mo or £200/yr).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# OpenAI Responses API credentials for transcript pacing analysis.
OPENAI_API_KEY=
# Optional model override. Text analysis defaults to gpt-4.1-mini.
OPENAI_PACING_MODEL=gpt-4.1-mini
# Exceptionally long videos are split when either limit is reached, then their
# chunk findings are synthesized into one video-wide analysis.
OPENAI_PACING_MAX_WINDOWS_PER_CALL=40
OPENAI_PACING_MAX_TRANSCRIPT_CHARS_PER_CALL=120000
# Limits simultaneous chunk requests. Defaults to 3.
OPENAI_PACING_MAX_PARALLEL_CHUNKS=3

# Surface-level (API-only) analyses. Both are optional and are text analyses,
# so they default to gpt-4.1-mini: retention→transcript attribution
# (drop-off/gain explanations + tips) and title/thumbnail/hook packaging
# alignment (which also reads the thumbnail image). Override either
# independently if needed.
OPENAI_RETENTION_ATTRIBUTION_MODEL=gpt-4.1-mini
OPENAI_PACKAGING_MODEL=gpt-4.1-mini

# Vision/audio models for analysing harvested retention-window media (see
# lib/retention-window-media-analysis.ts). These are not text analyses, so they
# keep their own defaults. Audio analysis needs an audio-capable Chat
# Completions model, so it defaults to gpt-audio-mini. Override either
# independently if needed.
OPENAI_SNAPSHOT_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_AUDIO_ANALYSIS_MODEL=gpt-audio-mini
# How long the signed read URL handed to OpenAI for one harvested snapshot/
# audio clip stays valid, in seconds. Default 10 minutes.
RETENTION_WINDOW_ANALYSIS_MEDIA_URL_EXPIRY_SECONDS=600

# Text-only model that combines a window's already-computed evidence
# (retention delta, transcript, editing metrics, snapshot/audio analysis)
# into narrated events (see lib/retention-window-event-synthesis.ts). No
# vision/audio tokens, so this is a text analysis and defaults to gpt-4.1-mini.
OPENAI_EVENT_SYNTHESIS_MODEL=gpt-4.1-mini

# --- Deep-analysis calibration and staged rollout ---
# Deterministic ranking thresholds; changing these does not trigger model calls.
DEEP_ANALYSIS_MIN_INSIGHT_SCORE=0.48
DEEP_ANALYSIS_MAX_INSIGHTS_PER_WINDOW=3
DEEP_ANALYSIS_MAX_RECOMMENDATIONS_PER_WINDOW=2
# Stable user-level percentage rollout (0..100), plus independent kill switches.
DEEP_ANALYSIS_ROLLOUT_PERCENT=100
DEEP_ANALYSIS_INSIGHTS_ENABLED=true
DEEP_ANALYSIS_RECOMMENDATIONS_ENABLED=true
# The raw evidence/cost panel is useful during calibration and can be hidden
# independently once the creator-facing tabs are the primary production UI.
DEEP_ANALYSIS_EVIDENCE_PANEL_ENABLED=true

# --- Deep-analysis autonomous completion ---
# A deep analysis usually needs more than one serverless invocation: a pass that
# runs out of budget hands the rest to a fresh one, and a scheduled watchdog
# resumes anything that stalled. Both call this deployment back over HTTP, and
# both present this secret — so without it a deep analysis only makes progress
# while someone has the report page open. Generate a long random string.
DEEP_ANALYSIS_WORKER_SECRET=
# What the scheduled watchdog authenticates with, if you'd rather it differed
# from the worker secret above. Either is accepted on both endpoints, so setting
# just one of them is fine. Vercel's own CRON_SECRET is accepted too.
#
# The schedule itself lives in the database (pg_cron + pg_net, see
# supabase/migrations/20260818120000_deep_analysis_autonomous_completion.sql),
# so it also needs the endpoint URL and this secret in Supabase Vault:
#   select vault.create_secret(
#     'https://<your-app-host>/api/cron/resume-deep-analysis',
#     'deep_analysis_resume_url');
#   select vault.create_secret('<this value>', 'deep_analysis_cron_secret');
DEEP_ANALYSIS_CRON_SECRET=
# Only for deployments behind Vercel deployment protection (previews, mostly):
# Vercel sets this itself, and the server-to-server calls above pass it through
# so protection answers them instead of an auth page. Store the same value as
# the 'deep_analysis_bypass_secret' Vault secret for the scheduled watchdog.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Raw source-file uploads (optional; sensible defaults shown) ---
# Object-storage bucket the raw video uploads land in (created by the
# source_files migration). Defaults to "source-files".
SOURCE_FILE_BUCKET=source-files
# Max accepted upload size in bytes. Default 30 GB (must be <= the bucket's
# file_size_limit). 32212254720 = 30 * 1024^3.
SOURCE_FILE_MAX_UPLOAD_BYTES=32212254720
# How many seconds the uploaded file's duration may differ from the YouTube
# value and still pass. Default 5.
SOURCE_FILE_DURATION_TOLERANCE_SECONDS=5
# Minimum filename/title similarity (0..1) below which we show the soft "doesn't
# match the title" warning. Default 0.3.
SOURCE_FILE_FILENAME_SIMILARITY_THRESHOLD=0.3
# --- Parallel multipart uploads (optional) ---
# When the four S3 connection values below are set, large uploads use a parallel
# multipart upload (many file parts PUT concurrently) instead of a single PUT,
# which lets a multi-GB upload actually saturate the user's uplink. Without them
# the app falls back to the single-PUT Supabase Storage client.
#
# Generate the access key + copy the endpoint/region from the Supabase dashboard:
# Project Settings → Storage → S3 connection (/dashboard/project/_/storage/s3).
# Use the *.storage.supabase.co host (not *.supabase.co) for faster large uploads.
#   ENDPOINT example: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Notes for Supabase (vs. raw AWS S3 / R2):
#   • Incomplete multipart uploads are auto-aborted after 24h — no lifecycle rule
#     to configure. (On raw S3/R2 you'd add an AbortIncompleteMultipartUpload
#     lifecycle rule yourself, in the AWS S3 / Cloudflare R2 console.)
#   • Hosted Supabase Storage has no CORS settings to configure; the gateway
#     handles cross-origin responses. (On raw S3/R2 you must add a CORS rule that
#     exposes the ETag header, or the browser can't report part ETags.) If a real
#     multipart upload fails with a "missing ETag" error, the ETag isn't being
#     exposed and the fallback is a TUS resumable upload instead of presigned parts.
SOURCE_FILE_S3_ENDPOINT=
SOURCE_FILE_S3_REGION=
SOURCE_FILE_S3_ACCESS_KEY_ID=
SOURCE_FILE_S3_SECRET_ACCESS_KEY=
# Target size per part, in bytes. Default 64 MiB (67108864). The provider grows
# this automatically if needed to stay under S3's 10,000-part limit.
SOURCE_FILE_MULTIPART_PART_SIZE_BYTES=67108864
# Files at or above this size use multipart; smaller ones use a single PUT.
# Defaults to the part size.
SOURCE_FILE_MULTIPART_THRESHOLD_BYTES=67108864
# How long signed upload targets stay valid, in seconds. Default 6h (21600).
SOURCE_FILE_SIGNED_UPLOAD_EXPIRY_SECONDS=21600

# --- Video normalisation: 4K/original -> 360p proxy via Qencode (optional) ---
# When this whole block is configured, a validated upload is handed to Qencode
# for a 360p H.264 transcode. Qencode is not given a destination to write to
# directly — its generic S3 destination writer was found to silently produce
# 0-byte objects against Supabase's S3-compatible endpoint while still
# reporting success. Instead Qencode holds the finished file on its own
# temporary storage for 24h and hands back a download URL in the completion
# callback; we pull it into the S3 connection block above ourselves. Once the
# proxy lands the (large) original is deleted and playback uses the proxy.
# Leave QENCODE_API_KEY unset to disable — uploads then keep the original
# exactly as before. Requires the S3 connection block above and an
# APP_BASE_URL the Qencode callback can reach.
#
# Qencode account API key (Dashboard -> API -> API Key).
QENCODE_API_KEY=
# Optional API base override. Defaults to https://api.qencode.com/v1
QENCODE_API_BASE_URL=
# Proxy target height in px (aspect ratio preserved). Default 360 — one small
# rendition serves both playback and analysis, since transcoding is the most
# expensive part of deep analysis. Raise (e.g. 720/1080) for a higher-quality
# playback proxy; the analysis proxy below then rides along as a cheaper second
# output for extraction to decode.
QENCODE_PROXY_HEIGHT=360
# Height in px of a second, smaller "analysis" proxy produced in the same
# Qencode job. Deep-analysis extraction (scene-cue scans, frame/audio grabs)
# decodes this instead of the playback proxy — decoding a smaller rendition
# cuts that CPU cost several-fold, and nothing extraction feeds a model needs
# the extra resolution. Only produced when smaller than QENCODE_PROXY_HEIGHT, so
# at the default 360p playback height it's inert (the one 360p proxy serves
# analysis too). Default 360; set to 0 to disable the second output entirely.
QENCODE_ANALYSIS_PROXY_HEIGHT=360
# Estimated Qencode transcoding cost in dollars per minute of video, shown in
# the deep-analysis cost breakdown. Default 0.015 ($0.15 for a 10-minute video).
QENCODE_TRANSCODING_USD_PER_MINUTE=0.015
# Optional extra Qencode `format` knobs as JSON, merged over the defaults, e.g.
# {"video_bitrate":"4000k","framerate":30}.
QENCODE_PROXY_FORMAT_OVERRIDES=
# How long the signed source URL handed to Qencode stays valid, seconds. Default
# 6h (21600) — must exceed how long Qencode may take to fetch a big original.
QENCODE_SOURCE_URL_EXPIRY_SECONDS=21600
# Public base URL of this app, used to build the status callback Qencode POSTs
# to (e.g. https://app.viewlio.ai). On Vercel, VERCEL_URL is used as a
# fallback automatically.
APP_BASE_URL=
# Shared secret appended to the callback URL (?secret=...) and verified on the
# way back in, so the callback can't be forged. Generate a long random string.
QENCODE_CALLBACK_SECRET=
